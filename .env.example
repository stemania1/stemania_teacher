# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SECRET_KEY=your-service-role-key

# App
NEXT_PUBLIC_SITE_URL=https://teacher.stemania.com
# Admin app URL (for "Join Our Team" link). Dev: http://localhost:3000, Prod: https://admin.stemania.com
NEXT_PUBLIC_ADMIN_URL=https://admin.stemania.com
NEXT_PUBLIC_ADMIN_APP_URL=https://admin.stemania.com
SUPER_ADMIN_EMAIL=your-super-admin@example.com

# Upstash Redis (Rate limiting — optional; in-memory fallback if not set)
UPSTASH_REDIS_REST_URL=https://your-redis-region.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Sentry (Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Stripe Connect (Bank account onboarding for teacher payouts)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# E2E Testing (Playwright — required for `npm run test:e2e`)
E2E_TEACHER_EMAIL=your-test-teacher@example.com
E2E_TEACHER_PASSWORD=your-test-teacher-password
